# Copy to .env.local and fill in when the owner supplies accounts.
# Every value is intentionally EMPTY in this phase. Empty = feature stays
# NoOp / local; the app builds and runs without any of them.

# Runtime mode: functional (default, no ads shown) | mock (debug ad fixtures)
EXPO_PUBLIC_APP_MODE=

# Legal documents (in-app viewer). Empty = bundled development placeholder.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# Store review destination for "Rate Us" (the app's own listing only).
EXPO_PUBLIC_STORE_REVIEW_URL=

# Firebase is configured by google-services.json at the repo root (git-ignored),
# not by environment variables. See docs/FIREBASE.md.

# Advertising (deferred) — app-level IDs; unit IDs go in the typed config.
EXPO_PUBLIC_ADMOB_APP_ID=
EXPO_PUBLIC_GAM_NETWORK_CODE=
EXPO_PUBLIC_PANGLE_APP_ID=
EXPO_PUBLIC_TOPON_APP_ID=
EXPO_PUBLIC_TOPON_APP_KEY=
EXPO_PUBLIC_APPLOVIN_SDK_KEY=

# Attribution (deferred)
EXPO_PUBLIC_ADJUST_APP_TOKEN=
